{
  "expo": {
    "name": "AppBABY",
    "slug": "AppBABY",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.appbaby.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmara é usada para digitalizar documentos médicos.",
        "NSPhotoLibraryUsageDescription": "Para importar fotografias de documentos médicos.",
        "NSFaceIDUsageDescription": "Para proteger os dados de saúde da família com Face ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pt.appbaby.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Para proteger os dados de saúde da família com Face ID."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para proteger os dados de saúde da família com Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D6B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para importar fotografias de documentos médicos.",
          "cameraPermission": "A câmara é usada para digitalizar documentos médicos.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "A câmara é usada para digitalizar documentos médicos."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "appbaby",
    "experiments": {
      "typedRoutes": true
    }
  }
}
